# Required for real uploaded-audio processing.
OPENAI_API_KEY=replace_with_your_project_api_key

# Optional model overrides.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Optional local structured analysis. When Ollama is running and this model is
# installed, the demo prefers it over OpenAI for transcript analysis.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# Set to openai only when you explicitly want cloud transcript analysis.
ANALYSIS_PROVIDER=ollama

# Optional local server configuration.
PORT=4173
