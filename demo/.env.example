# Optional cloud providers. The default pipeline is fully local and does not
# require an OpenAI API key.
OPENAI_API_KEY=replace_with_your_project_api_key

# Optional model overrides.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Local transcription defaults. Run ./scripts/setup-local-transcription.sh.
MLX_WHISPER_PYTHON=.venv/bin/python
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Optional override. Defaults: mlx on macOS, faster-whisper on Linux/Windows.
# TRANSCRIPTION_PROVIDER=mlx

# Linux/Windows local transcription. These are the defaults on those platforms.
# Run scripts/setup-cross-platform-ai.sh on Linux or
# scripts/setup-cross-platform-ai.ps1 in PowerShell on Windows.
# CROSS_PLATFORM_PYTHON=.venv-cross-platform/bin/python
FASTER_WHISPER_MODEL=large-v3-turbo

# Speaker diarization defaults to FluidAudio on macOS and pyannote on
# Linux/Windows. pyannote requires accepting its model agreement and providing
# a scoped Hugging Face token; never commit the token.
# Optional override. Defaults: fluid on macOS, pyannote on Linux/Windows.
# DIARIZATION_PROVIDER=fluid
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# HUGGINGFACE_TOKEN=replace_with_your_scoped_token
PYANNOTE_METRICS_ENABLED=0

# Local structured analysis defaults.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# Cloud use is explicit: set either provider to openai only when intended.
ANALYSIS_PROVIDER=ollama

# Optional local server configuration.
PORT=4173
